# Database (async SQLAlchemy URL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/housify

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email / SMTP
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-app-password
MAIL_FROM=your-email@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Housify

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenRouteService
OpenRouteServiceKey=your-openrouteservice-api-key

# Cloudflare R2
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
BUCKET_NAME=housify
PUBLIC_BASE_URL=https://your-public-r2-domain

# Frontend and cookies
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Production: set COOKIE_SECURE=true. If frontend and API are on different sites,
# configure COOKIE_SAMESITE=none and COOKIE_DOMAIN for your deployment.
